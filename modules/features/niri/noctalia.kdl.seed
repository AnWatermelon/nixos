layout {

    focus-ring {
        active-color   "#f0b0ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#f0b0ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#f0b0ff"
        inactive-color "#662f78"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#f0b0ff80"
    }
}

recent-windows {
    highlight {
        active-color "#f0b0ff"
        urgent-color "#ffb4ab"
    }
}
